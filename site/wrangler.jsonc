{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "chef-site",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "workers_dev": true,
  "build": { "command": "node scripts/build.mjs" },
  "assets": { "directory": "dist", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "MEMBER", "class_name": "Member" }, { "name": "MEMBERS", "class_name": "Members" }, { "name": "ORG", "class_name": "Organization" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Member"] }, { "tag": "v2", "new_sqlite_classes": ["Members"] }, { "tag": "v3", "new_sqlite_classes": ["Organization"] }],
  "containers": [
    {
      "class_name": "Member",
      "scheduling_policy": "durable_object",
      "images": { "installer": { "dockerfile": "./installer/Dockerfile", "build_context": ".." } }
    }
  ],
  "vars": { "SANDBOX_IMAGE": "", "ENGINE_VERSION": "", "SITE_URL": "https://chef.playgrndlabs.com" }
}
