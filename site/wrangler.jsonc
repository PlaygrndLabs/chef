{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "getchef",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": { "directory": "public", "binding": "ASSETS", "run_worker_first": ["/start", "/callback", "/api/*"] },
  "durable_objects": { "bindings": [{ "name": "SETUP", "class_name": "Setup" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Setup"] }],
  "containers": [
    {
      "class_name": "Setup",
      "scheduling_policy": "durable_object",
      "images": { "installer": { "dockerfile": "./installer/Dockerfile", "build_context": ".." } }
    }
  ],
  "vars": { "SANDBOX_IMAGE": "" }
}
