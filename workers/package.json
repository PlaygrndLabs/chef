{
  "name": "@chef/workers",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "embed": "node --import tsx scripts/embed.ts",
    "typecheck": "node --import tsx scripts/embed.ts --check && tsc -p tsconfig.json",
    "build": "wrangler deploy --config ../wrangler.jsonc --dry-run --outdir dist",
    "dev": "wrangler dev --config ../wrangler.jsonc",
    "deploy": "pnpm --dir .. run deploy"
  },
  "dependencies": {
    "@cloudflare/sandbox": "1.0.0",
    "@copilotkit/runtime": "1.78.0",
    "@chef/adapters": "workspace:*",
    "@chef/core": "workspace:*",
    "@chef/template": "workspace:*",
    "@typesafe-ai/sdk": "0.6.0",
    "agents": "0.28.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "tsx": "4.23.15",
    "wrangler": "4.149.0"
  }
}
