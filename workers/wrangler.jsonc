{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "chef",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "build": { "command": "pnpm --dir .. build" },
  "assets": { "directory": "../apps/dashboard/dist", "binding": "ASSETS", "run_worker_first": true },
  "artifacts": [{ "binding": "ARTIFACTS", "namespace": "chef" }],
  "durable_objects": {
    "bindings": [
      { "name": "PROJECT", "class_name": "ProjectAgent" },
      { "name": "SESSION", "class_name": "SessionAgent" },
      { "name": "SETTINGS", "class_name": "Settings" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ProjectAgent", "SessionAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["Settings"] }
  ],
  "containers": [
    {
      "class_name": "SessionAgent",
      "scheduling_policy": "durable_object",
      "images": { "coder": { "dockerfile": "./sandbox/Dockerfile" } }
    }
  ],
  "workflows": [{ "name": "upstream-sync", "binding": "UPSTREAM_SYNC", "class_name": "UpstreamSync" }],
  "vectorize": [{ "binding": "MEMORY", "index_name": "chef-memory" }],
  "ai": { "binding": "AI" },
  "triggers": {
    "events": [
      {
        "type": "cf.artifacts.repo.pushed",
        "filter": { "namespace": "chef" },
        "targets": [{ "type": "workflow", "workflow_name": "upstream-sync" }]
      }
    ]
  },
  "secrets": { "required": ["TYPESAFE_API_KEY", "CF_API_TOKEN", "CF_ACCOUNT_ID"] },
  "vars": {
    "PLANNER_MODEL": "claude-opus-5-5",
    "REVIEWER_MODEL": "claude-opus-5-5",
    "CODER_MODEL": "claude-sonnet-5-5",
    "JEV_MODEL": "jev-1.13.0",
    "PREVIEW_WORKER": "chef-project",
    "ATTEMPTS": "2",
    "VOICE_MODEL": "gpt-live-1",
    "REALTIME_MODEL": "gpt-realtime",
    "VOICE": "marin",
    "COPILOTKIT_TELEMETRY_DISABLED": "true"
  }
}
